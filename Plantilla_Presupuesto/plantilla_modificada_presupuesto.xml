<t t-name="sale.report_saleorder_document">
    <t t-call="web.basic_layout">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <t t-set="forced_vat" t-value="doc.fiscal_position_id.foreign_vat"/>
        <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
        <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>
        
        <style>
            .cotizacion-header {
                margin-bottom: 30px;
                overflow: hidden;
            }
            .logo-section {
                float: left;
                width: 40%;
            }
            .logo-container {
                display: flex;
                align-items: center;
                gap: 8px;
            }
            .logo-caliper {
                width: 25px;
                height: 40px;
                position: relative;
                margin-right: 5px;
            }
            .logo-caliper::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                width: 3px;
                height: 40px;
                background: #000;
                border-radius: 2px;
            }
            .logo-caliper::after {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                width: 20px;
                height: 3px;
                background: #000;
                border-radius: 2px;
                transform: rotate(-15deg);
                transform-origin: left top;
            }
            .logo-m {
                font-size: 48px;
                font-weight: bold;
                line-height: 1;
                display: inline-block;
                position: relative;
                color: #8B0000;
            }
            .logo-lightning {
                width: 20px;
                height: 30px;
                position: relative;
                margin-left: 5px;
            }
            .logo-lightning::before {
                content: '';
                position: absolute;
                left: 50%;
                top: 0;
                transform: translateX(-50%);
                width: 0;
                height: 0;
                border-left: 6px solid transparent;
                border-right: 6px solid transparent;
                border-bottom: 8px solid #FFD700;
            }
            .logo-lightning::after {
                content: '';
                position: absolute;
                left: 50%;
                top: 8px;
                transform: translateX(-50%);
                width: 0;
                height: 0;
                border-left: 4px solid transparent;
                border-right: 4px solid transparent;
                border-top: 12px solid #FFD700;
            }
            /* Estilos para logo de imagen 2 (bracket L arriba, triángulo abajo) */
            .logo-bracket {
                width: 20px;
                height: 15px;
                position: absolute;
                top: -10px;
                left: 0;
            }
            .logo-bracket::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                width: 3px;
                height: 15px;
                background: #000;
            }
            .logo-bracket::after {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                width: 12px;
                height: 3px;
                background: #000;
            }
            .logo-triangle-bottom {
                position: absolute;
                bottom: -8px;
                left: 50%;
                transform: translateX(-50%);
                width: 0;
                height: 0;
                border-left: 6px solid transparent;
                border-right: 6px solid transparent;
                border-top: 8px solid #FFD700;
            }
            .logo-text {
                font-size: 20px;
                font-weight: bold;
                margin-top: 5px;
                margin-bottom: 5px;
                color: #333;
            }
            .logo-slogan {
                font-size: 11px;
                margin-top: 0;
                color: #333;
            }
            .company-info {
                float: right;
                width: 55%;
                text-align: right;
                clear: right;
            }
            .company-name {
                font-size: 20px;
                font-weight: bold;
                color: #8B0000;
                margin-bottom: 8px;
                text-align: right;
            }
            .company-details {
                font-size: 11px;
                line-height: 1.4;
                text-align: right;
                color: #333;
            }
            .header-separator {
                clear: both;
                border-top: 1px solid #000;
                margin-top: 15px;
                margin-bottom: 20px;
            }
            .fecha-documento {
                clear: both;
                padding-top: 15px;
                font-size: 12px;
                margin-bottom: 20px;
            }
            .client-info {
                margin-bottom: 20px;
            }
            .client-name {
                font-size: 16px;
                font-weight: bold;
                margin-bottom: 5px;
            }
            .client-contact {
                font-size: 13px;
                margin-bottom: 10px;
            }
            .intro-text {
                font-size: 12px;
                margin-bottom: 20px;
            }
            .productos-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 20px;
            }
            .productos-table th,
            .productos-table td {
                border: 1px solid #000;
                padding: 8px;
                font-size: 12px;
            }
            .productos-table th {
                background-color: #f0f0f0;
                font-weight: bold;
            }
            .th-cant {
                width: 8%;
                text-align: left;
            }
            .th-desc {
                width: 54%;
                text-align: left;
            }
            .th-unit {
                width: 19%;
                text-align: right;
            }
            .th-total {
                width: 19%;
                text-align: right;
            }
            .td-desc {
                text-align: left;
            }
            .td-unit, .td-total {
                text-align: right;
            }
            .descuento-row {
                border-top: 1px solid #000;
                border-bottom: 1px solid #000;
            }
            .descuento-text {
                padding-left: 8px;
            }
            .descuento-line {
                border-bottom: 1px dotted #000;
                display: inline-block;
                width: 100%;
                height: 1px;
                margin: 0 8px;
            }
            .summary-table {
                width: 38%;
                border-collapse: collapse;
                margin-left: auto;
                margin-bottom: 20px;
            }
            .summary-table td {
                border: 1px solid #000;
                padding: 6px 8px;
                font-size: 12px;
                text-align: right;
            }
            .summary-label {
                text-align: left;
                padding-right: 15px;
            }
            .total-final {
                font-weight: bold;
            }
            .consideraciones {
                margin-top: 30px;
                margin-bottom: 20px;
            }
            .consideraciones-title {
                font-weight: bold;
                font-size: 13px;
                margin-bottom: 8px;
            }
            .consideraciones-list {
                margin-left: 20px;
                font-size: 12px;
                line-height: 1.6;
            }
            .signatures-section {
                margin-top: 60px;
                margin-bottom: 40px;
            }
            .signature-left {
                float: left;
                width: 45%;
            }
            .signature-right {
                float: right;
                width: 45%;
                text-align: right;
            }
            .signature-line {
                border-top: 1px solid #000;
                margin-top: 40px;
                padding-top: 5px;
            }
            .signature-name {
                font-size: 12px;
            }
            .signature-title {
                font-size: 11px;
                margin-top: 5px;
            }
            .footer-services {
                clear: both;
                text-align: center;
                margin-top: 60px;
                padding-top: 20px;
                font-size: 10px;
                text-transform: uppercase;
                line-height: 1.4;
            }
            /* Estilos para alinear información de empresa en header del layout externo */
            .o_report_layout_standard .header table tr td:last-child,
            .o_report_layout_standard .header .col-6:last-child,
            .o_report_layout_standard .header .col-4:last-child,
            .o_report_layout_standard .header .col-3:last-child {
                text-align: right !important;
            }
            .o_report_layout_standard .header table tr td:last-child p,
            .o_report_layout_standard .header .col-6:last-child p,
            .o_report_layout_standard .header .col-4:last-child p,
            .o_report_layout_standard .header .col-3:last-child p {
                text-align: right !important;
            }
            /* Estilos generales para header de Odoo */
            .header table tr td:last-child,
            .header .col-6:last-child,
            .header .col-4:last-child {
                text-align: right !important;
            }
            .header table tr td:last-child p,
            .header .col-6:last-child p,
            .header .col-4:last-child p {
                text-align: right !important;
            }
            /* Mantener logo a la izquierda */
            .header table tr td:first-child,
            .header .col-6:first-child,
            .header .col-4:first-child {
                text-align: left !important;
            }
            /* Ocultar texto del logo */
            .logo-text,
            .logo-slogan {
                display: none !important;
            }
            /* Ocultar completamente el header del layout externo */
            .oe_structure,
            .header,
            .o_report_layout_standard .header,
            .o_report_layout_standard .oe_structure,
            div.header,
            table.header,
            .o_report_layout_standard div.header,
            .o_report_layout_standard table.header,
            .main-content .header,
            .main-content .oe_structure,
            body > .header,
            body > .oe_structure,
            .header tbody,
            .header thead,
            .header tr,
            .header td,
            .header th {
                display: none !important;
                visibility: hidden !important;
                height: 0 !important;
                margin: 0 !important;
                padding: 0 !important;
                overflow: hidden !important;
                line-height: 0 !important;
                font-size: 0 !important;
            }
            /* Ocultar cualquier elemento que contenga información de la empresa en el header */
            .header table,
            .header div,
            .header p,
            .oe_structure table,
            .oe_structure div {
                display: none !important;
            }
            /* Asegurar que nuestro header personalizado se muestre */
            .cotizacion-header {
                display: block !important;
                visibility: visible !important;
            }
        </style>

        <div class="page">

            <!-- Header personalizado estilo imagen 2 con datos a la derecha -->
            <div class="cotizacion-header">
                <div class="logo-section">
                    <div style="display: flex; align-items: flex-start;">
                        <div t-if="doc.company_id.logo" style="margin-right: 10px;">
                            <img t-att-src="image_data_uri(doc.company_id.logo)" style="max-height: 80px; max-width: 200px;"/>
                        </div>
                    </div>
                </div>
                <div class="company-info">
                    <div class="company-name" t-field="doc.company_id.name"/>
                    <div class="company-details">
                        <div t-field="doc.company_id.street"/>
                        <div t-if="doc.company_id.street2" t-field="doc.company_id.street2"/>
                        <div t-field="doc.company_id.city"/>
                        <div t-if="doc.company_id.state_id" t-field="doc.company_id.state_id.name"/>
                        <div t-if="doc.company_id.country_id" t-field="doc.company_id.country_id.name"/>
                    </div>
                </div>
                <div class="header-separator"></div>
            </div>

            <!-- Información del cliente -->
            <div class="client-info">
                <div class="client-name" t-field="doc.partner_id.name"/>
                <div class="client-contact" t-if="doc.partner_id.comment">
                    <span t-field="doc.partner_id.comment"/>
                </div>
                <div class="intro-text">
                    Mediante la presente le envío la cotización que me solicitó para la fabricación del siguiente equipo:
                </div>
            </div>

            <!-- Bloque de información oculto para compatibilidad con XPath -->
            <div class="row mt-4 mb-4" id="informations" style="display: none;">
                <div t-if="doc.client_order_ref" class="col-auto col-3 mw-100 mb-2" name="informations_reference">
                    <strong>Your Reference:</strong>
                    <p class="m-0" t-field="doc.client_order_ref"/>
                </div>
                <div t-if="doc.date_order" class="col-auto col-3 mw-100 mb-2" name="informations_date">
                    <strong t-if="doc.state in ['draft', 'sent']">Quotation Date:</strong>
                    <strong t-else="">Order Date:</strong>
                    <p class="m-0" t-field="doc.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                </div>
                <div class="col-auto col-3 mw-100 mb-2" name="expiration_date">
                    <t t-if="doc.validity_date and doc.state in ['draft', 'sent']">
                        <strong>Expiration:</strong>
                        <p class="m-0" t-field="doc.validity_date"/>
                    </t>
                </div>
                <div t-if="doc.user_id.name" class="col-auto col-3 mw-100 mb-2">
                    <strong>Salesperson:</strong>
                    <p class="m-0" t-field="doc.user_id"/>
                </div>
            </div>

            <!-- Tabla de productos -->
            <table class="productos-table">
                <thead>
                    <tr>
                        <th class="th-cant" name="th_quantity">Cant.</th>
                        <th class="th-desc" name="th_description">Descripción</th>
                        <th class="th-unit" name="th_priceunit">Costo Unit</th>
                        <th name="th_discount" t-if="display_discount" class="text-end" style="display: none;">
                            <span>Disc.%</span>
                        </th>
                        <th name="th_taxes" class="text-end" style="display: none;">Taxes</th>
                        <th class="th-total" name="th_subtotal">Costo Total</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="total_descuento" t-value="0"/>
                    <t t-set="subtotal_sin_descuento" t-value="0"/>
                    <t t-foreach="lines_to_report" t-as="line">
                        <t t-if="not line.display_type and not line.is_downpayment">
                            <tr>
                                <td class="text-center" name="td_quantity">
                                    <span t-field="line.product_uom_qty"/>
                                </td>
                                <td class="td-desc" name="td_name">
                                    <span t-field="line.name"/>
                                </td>
                                <td class="td-unit" name="td_priceunit">
                                    <span t-field="line.price_unit" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                                </td>
                                <td t-if="display_discount" class="text-end" style="display: none;">
                                    <span t-field="line.discount"/>
                                </td>
                                <t t-set="taxes" t-value="', '.join([(tax.description or tax.name) for tax in line.tax_id])"/>
                                <td name="td_taxes" class="text-end" style="display: none;">
                                    <span t-out="taxes">Tax 15%</span>
                                </td>
                                <td class="td-total" name="td_subtotal">
                                    <span t-field="line.price_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                                </td>
                            </tr>
                            <t t-if="line.discount &gt; 0">
                                <t t-set="descuento_linea" t-value="line.price_subtotal * (line.discount / 100.0)"/>
                                <t t-set="total_descuento" t-value="total_descuento + descuento_linea"/>
                            </t>
                            <t t-set="subtotal_sin_descuento" t-value="subtotal_sin_descuento + line.price_subtotal"/>
                        </t>
                        <t t-elif="line.display_type == 'line_section'">
                            <tr>
                                <td name="td_section_line" colspan="99">
                                    <span t-field="line.name"/>
                                </td>
                            </tr>
                        </t>
                        <t t-elif="line.display_type == 'line_note'">
                            <tr>
                                <td name="td_note_line" colspan="99">
                                    <span t-field="line.name"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                    <t t-if="display_discount and total_descuento &gt; 0">
                        <t t-set="porcentaje_descuento" t-value="round((total_descuento / subtotal_sin_descuento) * 100, 0) if subtotal_sin_descuento &gt; 0 else 0"/>
                        <tr class="descuento-row">
                            <td colspan="2" class="descuento-text" style="position: relative;">
                                DESCUENTO DEL <t t-out="porcentaje_descuento"/>%
                                <span style="display: inline-block; width: 100px; border-bottom: 1px dotted #000; margin-left: 10px; vertical-align: middle;"></span>
                            </td>
                            <td></td>
                            <td class="td-total">
                                <span t-out="total_descuento" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>

            <!-- Tabla de resumen -->
            <t t-set="amount_untaxed" t-value="sum(line.price_subtotal for line in lines_to_report if not line.display_type and not line.is_downpayment)"/>
            <t t-set="amount_descuento" t-value="total_descuento"/>
            <t t-set="subtotal_con_descuento" t-value="amount_untaxed - amount_descuento"/>
            <t t-set="tax_totals" t-value="doc.tax_totals"/>
            <t t-set="amount_total" t-value="sum(line.price_total for line in lines_to_report if not line.display_type and not line.is_downpayment)"/>
            <t t-set="amount_tax" t-value="amount_total - amount_untaxed"/>
            <t t-set="iva_base" t-value="subtotal_con_descuento"/>
            <t t-set="iva_amount" t-value="round(iva_base * (amount_tax / amount_untaxed if amount_untaxed &gt; 0 else 0.13), 2) if amount_untaxed &gt; 0 else round(iva_base * 0.13, 2)"/>
            <t t-set="subtotal_con_iva" t-value="subtotal_con_descuento + iva_amount"/>
            <t t-set="retencion_iva" t-value="round(subtotal_con_iva * 0.01, 2)"/>
            <t t-set="total_final" t-value="subtotal_con_iva - retencion_iva"/>

            <div class="clearfix" name="so_total_summary">
                <div id="total" class="row" name="total">
                    <div class="ms-auto" style="width: 38%;">
                        <table class="summary-table">
                            <tr>
                                <td class="summary-label">Suma</td>
                                <td>
                                    <span t-out="subtotal_con_descuento" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="summary-label">IVA</td>
                                <td>
                                    <span t-out="iva_amount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="summary-label">Sub-total</td>
                                <td>
                                    <span t-out="subtotal_con_iva" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="summary-label">Retención IVA 1%</td>
                                <td>
                                    <span t-out="retencion_iva" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="summary-label total-final">TOTAL</td>
                                <td class="total-final">
                                    <span t-out="total_final" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>


            <!-- Consideraciones / Notas -->
            <div class="consideraciones" name="order_note">
                <div class="consideraciones-title">Consideraciones:</div>
                <ul class="consideraciones-list">
                    <li>Precio: Con IVA incluido.</li>
                    <li t-if="doc.payment_term_id">
                        Condición de pago: <span t-field="doc.payment_term_id.note"/>
                    </li>
                    <li t-if="not doc.payment_term_id">
                        Condición de pago: Anticipo del 60% al aceptar la oferta y el resto contra entrega.
                    </li>
                    <li>Tiempo de Entrega: 15 días.</li>
                    <li t-if="doc.note">
                        <span t-field="doc.note"/>
                    </li>
                </ul>
                <p t-if="doc.fiscal_position_id and not is_html_empty(doc.fiscal_position_id.sudo().note)" id="fiscal_position_remark">
                    <strong>Fiscal Position Remark:</strong>
                    <span t-field="doc.fiscal_position_id.sudo().note"/>
                </p>
            </div>

            <!-- Firmas -->
            <div class="signatures-section" name="signature">
                <t t-if="doc.signature">
                    <div class="signature-left">
                        <div class="signature-line">
                            <div class="signature-name" t-field="doc.partner_id.name"/>
                        </div>
                    </div>
                    <div class="signature-right">
                        <div class="signature-line">
                            <div class="signature-name" t-field="doc.user_id.name"/>
                            <div class="signature-title" t-if="doc.user_id.function" t-field="doc.user_id.function"/>
                            <div class="signature-title" t-if="not doc.user_id.function">Asesor Técnico</div>
                        </div>
                    </div>
                </t>
                <t t-if="not doc.signature">
                    <div class="signature-left">
                        <div class="signature-line">
                            <div class="signature-name" t-field="doc.partner_id.name"/>
                        </div>
                    </div>
                    <div class="signature-right">
                        <div class="signature-line">
                            <div class="signature-name" t-field="doc.user_id.name"/>
                            <div class="signature-title" t-if="doc.user_id.function" t-field="doc.user_id.function"/>
                            <div class="signature-title" t-if="not doc.user_id.function">Asesor Técnico</div>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Footer con servicios -->
            <div class="footer-services">
                <div>DISEÑO Y FABRICACION DE PROCESOS ELECTOMECANICOS PARA PRODUCCION</div>
                <div>AUTOMATIZACION, CONTROL INDUSTRIAL E INSTALACIONES ELECTRICAS</div>
                <div>DISEÑO Y REPARACION DE CIRCUITOS ELECTRONICOS INDUSTRIALES</div>
                <div>FABRICACION Y REPARACION DE TODO ELEMENTO METALMECANICO</div>
            </div>
        </div>
    </t>
</t>